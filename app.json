{
  "expo": {
    "name": "하루관리",
    "slug": "daily-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dailyapp.haru"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5A74FF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dailyapp.haru",
      "versionCode": 2,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-sensors",
        {
          "motionPermission": "오늘 걸은 걸음 수를 불러오기 위해 동작 및 피트니스 데이터에 접근합니다."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "현재 위치의 오늘 날씨를 보여드리기 위해 위치 정보를 사용합니다."
        }
      ]
    ]
  }
}